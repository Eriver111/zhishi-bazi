# ---- 新订单通道（先执行 schema-payment-channels.sql，见 docs/PAYMENT-CHANNELS.md） ----
PAY_DEFAULT_METHOD=wechat
PAY_WECHAT_ENABLED=true
PAY_ALIPAY_ENABLED=false

# ---- 虎皮椒微信：只在服务器填写正式配置，不提交、不发到聊天 ----
XUNHU_APPID=
XUNHU_APPSECRET=
# 用户渠道截图确认的网关；若以后更换渠道，以新渠道后台为准
XUNHU_API_URL=https://api.xunhupay.com/payment/do.html
# 普通通道先保持关闭；仅确认该渠道支持微信内 JSAPI 并实测通过后开启
XUNHU_WECHAT_IN_APP_ENABLED=false

# ---- ZPAY 支付宝：保留旧订单回调/查单；重新确认可用后才开启上面的开关 ----
PAY_API_URL=https://zpayz.cn/mapi.php
PAY_PID=你的商户ID
PAY_KEY=你的商户密钥

# ---- Supabase ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# ---- AI 模型 (DeepSeek 推荐，便宜+中文强) ----
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_API_KEY=sk-your-deepseek-api-key
AI_MODEL=deepseek-chat

# ---- 视觉模型（风水、面相、手相） ----
VISION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=sk-your-dashscope-api-key
VISION_MODEL=qwen3.7-plus

# ---- 站点 ----
SITE_URL=https://zhishi.online

# ---- 会话密钥 ----
TOKEN_SECRET=knowbazi-change-me-2026
FEEDBACK_RATE_SECRET=replace-with-a-long-random-secret

# ---- v3.0 定价 ----
PRICE_10_CREDITS=9.9
CREDITS_PER_PACK=10
PRICE_MONTHLY=29.9
MONTHLY_DURATION_DAYS=30

# ---- 免费体验 ----
FREE_CREDITS_PER_DEVICE=2

# ---- 邮件验证码 (阿里云 DirectMail) ----
ALI_AK_ID=your-ali-access-key-id
ALI_AK_SECRET=your-ali-access-key-secret
MAIL_FROM=noreply@mail.knowbazi.online
MAIL_NAME=知时
